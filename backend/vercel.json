{
    "version": 2,
    "builds": [
      {
        "src": "app.py",
        "use": "@vercel/python"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "app.py",
        "headers": {
            "Access-Control-Allow-Origin": "https://vyox.vercel.app",
            "Access-Control-Allow-Headers": "Accept, Content-Type, Origin, Authorization",
            "Access-Control-Allow-Credentials": "true"
            }
    }
]
  }
